# OpenAI-compatible API configuration
OPENAI_API_KEY=

# Optional. Leave empty to use the default OpenAI endpoint.
OPENAI_BASE_URL=

# Model used by the ecommerce customer service agent.
OPENAI_MODEL=

# Optional retry settings for transient API failures.
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_DELAY_SECONDS=1
